{
  "name": "anydoc-vision-export-markdown",
  "version": "2.0.0",
  "private": true,
  "description": "macOS PDF to Markdown using JXA, Objective-C Foundation and a singleton WebAssembly engine",
  "scripts": {
    "build": "node build.js",
    "convert:node": "tsx src/hosts/node.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && npm run test:probes && npm run test:directory",
    "test:unit": "tsx --test tests/unit.test.ts",
    "test:probes": "tsx tests/run-probes.ts",
    "test:directory": "tsx tests/run-directory.ts",
    "test:ocr": "tsx tests/run-ocr.ts",
    "doctor": "node tests/doctor.cjs"
  },
  "devDependencies": {
    "@firecrawl/anydoc-wasm": "0.2.4",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "@types/node": "26.6.5"
  }
}
