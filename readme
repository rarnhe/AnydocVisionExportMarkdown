# 1. 编译纯 JXA 脚本产物 （加入src/polyfills.ts后）
npx esbuild src/index_jxa.ts \
  --bundle \
  --format=iife \
  --platform=neutral \
  --target=es2020 \
  --inject:./src/polyfills.ts \
  --keep-names=false \
  --external:fs \
  --external:path \
  --external:@jxa/run \
  --define:IS_JXA_BUILD=true \
  '--banner:js=#!/usr/bin/osascript -l JavaScript' \
  --outfile=dist/index.jxa.js && chmod +x dist/index.jxa.js

# 2. 编译 Node CLI 产物
npx esbuild src/index_jxa.ts \
  --bundle \
  --platform=node \
  --target=node18 \
  --keep-names=false \
  --external:@jxa/run \
  --define:IS_JXA_BUILD=false \
  --outfile=dist/index.node.js && chmod +x dist/index.node.js

# 3. 三种执行方式测试
npx tsx src/index_jxa.ts "/Users/xu/Desktop/710号国际物业增资案-原告补充证据内容(2)-富昌公司0114提交.pdf"

./dist/index.jxa.js "/Users/xu/Desktop/710号国际物业增资案-原告补充证据内容(2)-富昌公司0114提交.pdf"

node ./dist/index.node.js "/Users/xu/Desktop/710号国际物业增资案-原告补充证据内容(2)-富昌公司0114提交.pdf"

