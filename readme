npx esbuild src/pdfSplitter_jxa.ts \
  --bundle \
  --format=iife \
  --platform=neutral \
  --target=es2020 \
  --external:fs \
  --external:path \
  --external:@jxa/run \
  --define:IS_JXA_BUILD=true \
  '--banner:js=#!/usr/bin/osascript -l JavaScript' \
  --outfile=dist/pdfSplitter.jxa.js && chmod +x dist/pdfSplitter.jxa.js

npx esbuild src/pdfSplitter_jxa.ts \
  --bundle \
  --platform=node \
  --target=node18 \
  --external:@jxa/run \
  --define:IS_JXA_BUILD=false \
  --outfile=dist/pdfSplitter.node.js && chmod +x dist/pdfSplitter.node.js

